   ],
   "source": [
    "from dotenv import load_dotenv\n",
    "load_dotenv()\n",
    "from langchain_groq import ChatGroq\n",
    "llm=ChatGroq(\n",
    "    model=\"openai/gpt-oss-120b\",\n",
    "    streaming=True\n",
    ")\n",
    "question=\"what is your name\"\n",
    "\n",
    "res=llm.stream(question)\n",
    "for chunk in res:\n",
    "    print(chunk.content,end=\"\")\n"
   ]
  }
 ],
